digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.4];
node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
app [label="{OrderCalculator|+ MIN_QUANTITY : int = 1\l+ MAX_QUANTITY : int = 10000\l+ MAX_UNIT_PRICE : double = 5000000.0\l+ MIN_DISCOUNT : double = 0.0\l+ MAX_DISCOUNT : double = 30.0\l+ VAT_RATE : double = 20.0\l|+ main(String[])\l+ isValid(int, double, double) : boolean\l+ describeError(int, double, double) : String\l+ calculateBase(int, double) : double\l+ applyDiscount(double, double) : double\l+ calculateVat(double, double) : double\l+ calculateTotal(int, double, double, double) : double\l~ process(String, String, String)\l~ parseInt(String) : Integer\l~ parseDouble(String) : Double\l- round2(double) : double\l- rub(double) : String\l}"];
sc [label="{SelfCheck|- failed : int\l|+ main(String[])\l- check(String, boolean)\l- near(double, double) : boolean\l}"];
sc -> app [label="вызывает", style=dashed];
}
